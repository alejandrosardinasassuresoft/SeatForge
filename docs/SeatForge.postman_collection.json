                "api",
                "v1",
                "attendees",
                "{{attendee_id}}",
                "registrations"
              ]
            },
            "description": "Lists registrations for one attendee with session/workshop context."
          }
        },
        {
          "name": "List Attendee Registrations Missing Attendee",
          "request": {
            "method": "GET",
