                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "attendees",
                "999999",
                "registrations"
              ]
            },
            "description": "Exercises the shared not_found envelope for a missing attendee. Expected HTTP status: 404."
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Show Dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/dashboard",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "dashboard"
              ]
            },
            "description": "Returns dashboard summary data for upcoming sessions and registration activity."
          }
        }
      ]
    }
  ],
